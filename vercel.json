{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.crepika.com" }
      ],
      "destination": "https://crepika.com/:path*",
      "permanent": true
    },
    {
      "source": "/tools/hashtag-generator",
      "destination": "/tools/hashtag-mixer",
      "permanent": true
    },
    {
      "source": "/tools/hash-generator",
      "destination": "/tools/hashtag-mixer",
      "permanent": true
    },
    {
      "source": "/tools/instagram-spacer",
      "destination": "/tools/insta-spacer",
      "permanent": true
    },
    {
      "source": "/tools/email-template",
      "destination": "/tools/text-counter",
      "permanent": true
    },
    {
      "source": "/tools/pricing-calculator",
      "destination": "/tools/adsense-rpm-calculator",
      "permanent": true
    },
    {
      "source": "/tools/platform-compare",
      "destination": "/tools/utm-url-builder",
      "permanent": true
    },
    {
      "source": "/tools/sns-analytics",
      "destination": "/tools/ctr-calculator",
      "permanent": true
    },
    {
      "source": "/tools/revenue-calculator",
      "destination": "/tools/adsense-rpm-calculator",
      "permanent": true
    },
    {
      "source": "/tools/email-analytics",
      "destination": "/tools/ctr-calculator",
      "permanent": true
    },
    {
      "source": "/tools/sns-calendar",
      "destination": "/tools/utm-url-builder",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(sitemap\\.xml|rss\\.xml|feed\\.xml|robots\\.txt|ads\\.txt|llms\\.txt|llms-full\\.txt|ai-index\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
